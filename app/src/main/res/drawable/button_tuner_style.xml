<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#5C7AE8"/>
            <corners android:radius="12dp"/>
            <stroke android:width="2dp" android:color="#7A92F0"/>
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#3A3A3A"/>
            <corners android:radius="12dp"/>
            <stroke android:width="1dp" android:color="#555555"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#4A5FD9"
                android:endColor="#3A4FB0"
                android:angle="270"/>
            <corners android:radius="12dp"/>
            <stroke android:width="2dp" android:color="#6A7FE9"/>
        </shape>
    </item>
</selector>

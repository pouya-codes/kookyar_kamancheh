<?xml version="1.0" encoding="utf-8"?>
<TableLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:background="@color/blue"
    android:shrinkColumns="*"
    android:stretchColumns="*" >

    <RadioGroup
        android:id="@+id/kamancheRG"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" >

        <TableRow
            android:id="@+id/tableRow2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" >

            <RadioButton
                android:id="@+id/MilaReSolRB"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="left"
                android:text="@string/milaReSol"
                 android:textSize="20sp"  />

            <RadioButton
                android:id="@+id/ReLaRelaRB"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="right"
                android:text="@string/ReLaRela"
                 android:textSize="20sp"  />

        </TableRow>

        <TableRow
            android:id="@+id/tableRow1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" >

            <RadioButton
                android:id="@+id/MiLaMilaRB"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/MiLaMila" 
                 android:textSize="20sp" />

            <RadioButton
                android:id="@+id/ReLaReSolRB"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ReLaReSol"
                 android:textSize="20sp"  />
        </TableRow>
    </RadioGroup>

    <TableRow android:layout_width="fill_parent" >

        <Button
            android:id="@+id/kamancheh_1"
            android:text="@string/sim_1" android:enabled="false" android:textColor="@color/black">
        </Button>

        <Button
            android:id="@+id/kamancheh_2"
            android:text="@string/sim_2" android:enabled="false" android:textColor="@color/black">
        </Button>

        <Button
            android:id="@+id/kamancheh_3"
            android:text="@string/sim_3" android:enabled="false" android:textColor="@color/black">
        </Button>

        <Button
            android:id="@+id/kamancheh_4"
            android:text="@string/sim_4" android:enabled="false" android:textColor="@color/black"/>
    </TableRow>

    <ImageView
        android:id="@+id/ivkamancheh"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/kamancheh" />

    <TableRow
        android:id="@+id/tableRow3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" >
    </TableRow>

    <TableRow android:layout_width="fill_parent" >

        <TextView
            android:id="@+id/pitch_label"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_span="4"
            android:gravity="center"
            android:padding="20px"
            android:text="0.0"
            android:textColor="@color/darkred" />

    </TableRow>

    <TableRow android:layout_width="fill_parent" >

        <com.PouyaApp.kookyarkamancheh.PitchView
            android:id="@+id/pitch_view"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_span="4" />
    </TableRow>

</TableLayout>
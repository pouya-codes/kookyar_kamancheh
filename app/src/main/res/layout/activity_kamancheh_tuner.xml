<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@color/backgroundColor">

    <include layout="@layout/app_bar" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <RadioGroup
            android:id="@+id/kamancheRG"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/MilaReSolRB"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/milaReSol"
                    android:textSize="15sp"
                    android:textColor="@color/white"
                    android:buttonTint="@color/accentColor" />

                <RadioButton
                    android:id="@+id/ReLaRelaRB"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/ReLaRela"
                    android:textSize="15sp"
                    android:textColor="@color/white"
                    android:buttonTint="@color/accentColor" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/MiLaMilaRB"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/MiLaMila"
                    android:textSize="15sp"
                    android:textColor="@color/white"
                    android:buttonTint="@color/accentColor" />

                <RadioButton
                    android:id="@+id/ReLaReSolRB"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/ReLaReSol"
                    android:textSize="15sp"
                    android:textColor="@color/white"
                    android:buttonTint="@color/accentColor" />
            </LinearLayout>
        </RadioGroup>

        <Spinner
            android:id="@+id/spinnerKookChange"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/spinner_background"
            android:popupBackground="@color/dropdownBackground"
            android:spinnerMode="dropdown" />

        <LinearLayout
            android:id="@+id/tuning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <CheckBox
                android:id="@+id/checkBox_tuning"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                android:clickable="false"
                android:buttonTint="@color/accentColor" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/tuning"
                android:textColor="@color/green"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/kamancheh_1"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:enabled="false"
                android:text="@string/sim_1"
                android:textSize="14sp"
                android:textColor="@color/white"
                app:backgroundTint="@color/primaryColorDark" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/kamancheh_2"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:enabled="false"
                android:text="@string/sim_2"
                android:textSize="14sp"
                android:textColor="@color/white"
                app:backgroundTint="@color/primaryColorDark" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/kamancheh_3"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:enabled="false"
                android:text="@string/sim_3"
                android:textSize="14sp"
                android:textColor="@color/white"
                app:backgroundTint="@color/primaryColorDark" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/kamancheh_4"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:enabled="false"
                android:text="@string/sim_4"
                android:textSize="14sp"
                android:textColor="@color/white"
                app:backgroundTint="@color/primaryColorDark" />
        </LinearLayout>

        <ImageView
            android:id="@+id/ivkamancheh"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:scaleType="fitCenter"
            android:src="@drawable/kamancheh" />
    </LinearLayout>

    <TextView
        android:id="@+id/pitch_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:text=""
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/accentColor" />

    <com.kookyar.common.PitchView
        android:id="@+id/pitch_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
